
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# --- MariaDB / MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tenderai_db
DB_USER=tenderai_app
DB_PASSWORD=YOUR_NEW_STRONG_PASSWORD

# --- Alembic migration account ---
# Use a dedicated database account with the privileges required to run migrations.
DB_MIGRATION_USER=tenderai_migration
DB_MIGRATION_PASSWORD=YOUR_MIGRATION_PASSWORD

# --- OpenRouter ---
# Get an API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Frontend / CORS ---
# JSON array of exact browser origins allowed to call this API.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Shared rate limiting ---
# Optional for local single-process development. Configure Redis/Upstash in production
# so rate limits are shared across workers and application instances.
# Use rediss:// for TLS-enabled Redis providers.
REDIS_URL=

# --- PDF OCR (Tesseract must be installed on the host) ---
OCR_LANGUAGES=fra+ara+eng
OCR_DPI=250
OCR_MIN_TEXT_CHARS=80
OCR_MAX_PAGES=50
# Optional path to the Tesseract tessdata directory.
OCR_TESSDATA=

# --- Logging ---
LOG_LEVEL=INFO

# --- Authentication / JWT ---
# Generate a random secret of at least 32 characters.
SECRET_KEY=replace_with_a_random_secret_of_at_least_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
